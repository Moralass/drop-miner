DATABASE_URL=postgresql://dropminer:dropminer@localhost:5432/dropminer
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Секрет для хэширования ключей активации. НЕ МЕНЯЙТЕ после выдачи ключей — они перестанут работать.
KEY_PEPPER=change-me-another-long-random-string
# Первый администратор создаётся при старте. После первого запуска ADMIN_PASSWORD лучше убрать из окружения.
ADMIN_EMAIL=
ADMIN_PASSWORD=
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://admin.dropminer.app

# Stripe
# Stripe необязателен: по умолчанию подписка активируется ключами.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
APP_URL=https://dropminer.app

# Twitch (официальный API, только публичные данные о трансляциях). Без них мониторинг LIVE недоступен (N/A).
# Создайте приложение на https://dev.twitch.tv/console и впишите Client ID и Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AI-функции (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT_PRO=50
AI_DAILY_LIMIT_TEAM=200
